# 복사해서 쓰세요:  cp .env.example .env
# .env 는 커밋되지 않습니다.

# --- DB (로컬 개발) ---
POSTGRES_DB=sobi
POSTGRES_USER=sobi
POSTGRES_PASSWORD=localdev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (로컬 개발) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=localdev

# --- JWT ---
JWT_SECRET=          # 깃 배쉬에 `openssl rand -base64 48` 명령어 입력해서 나온 64글자 시크릿 키 입력
JWT_ACCESS_EXP=1800000       # 30분(ms)
JWT_REFRESH_EXP=1209600000   # 14일(ms)

# --- Mail (Gmail SMTP 앱 비밀번호) ---
MAIL_USERNAME=
MAIL_PASSWORD=

# --- ssafy 금융 도메인 연결 ---
SSAFY_FINANCE_BASE_URL=
SSAFY_FINANCE_API_KEY=

# --- SSAFY GMS ---
GMS_API_KEY=
GMS_BASE_URL=

# Jev(System One) 판정. 없으면 전 요청이 GMS 폴백으로 돌아 크레딧이 마른다.
TYPESAFE_API_KEY=

# --- 외부 API 키 (각자 발급 / 팀 공용은 인프라에게 DM) ---
BIZINFO_API_KEY=
NTS_API_KEY=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
