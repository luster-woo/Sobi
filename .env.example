# 복사해서 쓰세요:  cp .env.example .env
# .env 는 커밋되지 않습니다.

# --- DB (로컬 개발) ---
POSTGRES_DB=sobi
POSTGRES_USER=sobi
POSTGRES_PASSWORD=localdev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (로컬 개발) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=localdev

# --- 외부 API 키 (각자 발급 / 팀 공용은 인프라에게 DM) ---
GMS_API_KEY=
BIZINFO_API_KEY=
NTS_API_KEY=
