# 환경변수 · 비밀
.env
.env.*
!.env.example
# VITE_ 접두사 변수는 빌드 결과에 그대로 박히는 공개 값이라 비밀이 아니다.
# 배포에서 목 데이터를 켜는 플래그가 들어 있어 커밋해야 빌드에 반영된다.
!frontend/.env.production
*.pem
*.key
secrets/

# Java / Gradle
build/
out/
.gradle/
*.jar
*.war
!gradle/wrapper/gradle-wrapper.jar

# Node / React
node_modules/
dist/
.vite/
npm-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# 로그 · 임시
*.log
tmp/

# DB 백업 (절대 커밋 금지)
*.dump
*.sql.gz
